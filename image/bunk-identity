#!/bin/sh
# Take this box's hostname, SSH host key, authorized_keys, and the egress
# CA's certificate from its
# identity drive, a raw tar archive on /dev/vdb that bunk writes when it
# creates the box.
set -eux
user=$(cat /etc/bunk/user)
# Not /tmp: this runs before local-fs.target, and a tmpfs mounted on /tmp
# partway through would hide what tar is unpacking.
d=$(mktemp -d /run/bunk-identity.XXXXXX)
tar -x -C "$d" -f /dev/vdb
name=$(cat "$d/hostname")
hostname "$name"
echo "$name" > /etc/hostname
sed -i "s/^127\.0\.1\.1[[:space:]].*/127.0.1.1 $name/" /etc/hosts
install -o root -g root -m 600 "$d/ssh_host_ed25519_key" /etc/ssh/ssh_host_ed25519_key
install -o root -g root -m 644 "$d/ssh_host_ed25519_key.pub" /etc/ssh/ssh_host_ed25519_key.pub
home=$(getent passwd "$user" | cut -d: -f6)
install -o "$user" -g "$user" -m 600 "$d/authorized_keys" "$home/.ssh/authorized_keys"
# The proxy shows this CA's certificates for hosts it inspects (see
# allow.txt's path entries).
if [ -f "$d/egress-ca.crt" ]; then
  install -m 644 "$d/egress-ca.crt" /usr/local/share/ca-certificates/bunk-egress.crt
  update-ca-certificates >/dev/null
fi
rm -rf "$d"
