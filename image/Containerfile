# A box's root filesystem. build.sh builds it from scratch on the build
# machine and exports it to rootfs.ext4; see there for what goes in the
# context. Nothing in it is per box: a box's hostname, host key, and
# authorized_keys come from its identity drive at boot.
FROM ubuntu:24.04
ARG USER UID HOMEDIR TARGETARCH

RUN userdel -r ubuntu && \
    apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      systemd systemd-sysv openssh-server iptables \
      git gh rsync socat curl ca-certificates sudo iproute2 dnsutils netcat-openbsd \
      nodejs npm python3-venv ruby build-essential jq strace less \
    && rm -rf /var/lib/apt/lists/*

# A Mac boots the box with Ubuntu's own arm64 kernel, which build.sh takes
# from /boot; vsock is a module there, loaded without udev. Firecracker boots
# its own kernel, with vsock built in.
RUN if [ "$TARGETARCH" = arm64 ]; then \
      apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends linux-image-virtual && \
      rm -rf /var/lib/apt/lists/* && echo vmw_vsock_virtio_transport > /etc/modules-load.d/vsock.conf; \
    fi

# The user matches the build machine's, so files keep their owners both ways,
# and so does its home directory, even on a Mac (/Users/NAME): then every
# absolute path bunk run copies in, in Claude's config and sessions or in a
# repository, means the same thing in the box. ~/.local/bin goes on PATH in
# /etc/environment, which every ssh session reads, not just login shells.
RUN mkdir -p "$(dirname "$HOMEDIR")" && useradd -m -d "$HOMEDIR" -u "$UID" -s /bin/bash -G sudo "$USER" && \
    echo "$USER ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/box-user && \
    install -d -o "$USER" -g "$USER" -m 700 $HOMEDIR/.ssh && \
    install -d -o "$USER" -g "$USER" $HOMEDIR/.local $HOMEDIR/.local/bin $HOMEDIR/.config $HOMEDIR/.claude && \
    mkdir -p /etc/bunk && echo "$USER" > /etc/bunk/user && \
    sed -i "s|^PATH=\"|PATH=\"$HOMEDIR/.local/bin:|" /etc/environment

# Agents, at the versions pinned in versions (image/bump.sh). build.sh fetched
# Rex's release archive and checked its sha256; Claude's installer checks the
# version it downloads.
ARG CLAUDE CODEX
COPY rex /usr/local/bin/rex
RUN npm i -g "@openai/codex@$CODEX"
USER $USER
RUN curl -fsSL https://claude.ai/install.sh | bash -s "$CLAUDE"
USER root

# What the box needs from Claude is managed settings, which outrank the user
# settings bunk run copies in from the host: no permission prompts (the box is
# the boundary) and no updater. bunk adds the user's token from
# `claude setup-token` each time the box starts.
# Onboarding is marked done so the TUI skips its direct check of
# api.anthropic.com, and the auto-mode nudge is marked seen so it doesn't
# wait on an answer.
COPY managed-settings.json /etc/claude-code/managed-settings.json
RUN v=$(su - "$USER" -c 'claude --version' | cut -d' ' -f1) && \
    su "$USER" -c "printf '{\"hasCompletedOnboarding\":true,\"lastOnboardingVersion\":\"%s\",\"hasSeenAutoDefaultNudge\":true}\n' $v > $HOMEDIR/.claude.json"

# Commits are made as the build machine's git user.
COPY user.gitconfig /etc/bunk/gitconfig
RUN git config --system --add include.path /etc/bunk/gitconfig

# hallpass's client side, from the build machine: boxes share its broker.
COPY hallpass /opt/hallpass/bin/hallpass
COPY hallpass-etc/ /etc/hallpass/
RUN ln -s hallpass /opt/hallpass/bin/hallpass-sign && \
    git config --system --add include.path /etc/hallpass/gitconfig


# bunk's guest side: identity at boot, then every channel over vsock.
# There is no network device; the host is vsock CID 2.
COPY bunk bunk-identity /usr/local/bin/
COPY units/ /etc/systemd/system/
RUN rm -f /etc/ssh/ssh_host_* && \
    printf 'HostKey /etc/ssh/ssh_host_ed25519_key\nPasswordAuthentication no\n' > /etc/ssh/sshd_config.d/bunk.conf && \
    systemctl enable ssh.service bunk-identity.service bunk-ready.service bunk-clock.service \
      bunk-ssh.service bunk-proxy.service \
      bunk-hallpass@hallpass.service bunk-hallpass@gh.service \
      bunk-hallpass@ssh.service bunk-hallpass@git.service && \
    systemctl mask systemd-networkd-wait-online.service systemd-resolved.service serial-getty@ttyS0.service serial-getty@hvc0.service && \
    printf '/dev/vda / ext4 rw,relatime 0 1\n' > /etc/fstab && passwd -d root >/dev/null

# Everything reaches the internet through the proxy, including sudo, apt, and
# Docker. npm sets its own GIT_SSH_COMMAND, so it's pinned to hallpass here.
# Docker needs iptables' legacy backend: Firecracker's CI kernel has no nf_tables.
RUN p=http://127.0.0.1:3128 && \
    printf "HTTPS_PROXY=$p\nHTTP_PROXY=$p\nhttps_proxy=$p\nhttp_proxy=$p\nNO_PROXY=localhost,127.0.0.1\nno_proxy=localhost,127.0.0.1\nGIT_SSH_COMMAND=/opt/hallpass/bin/hallpass ssh\n" >> /etc/environment && \
    printf "Acquire::http::Proxy \"$p\";\nAcquire::https::Proxy \"$p\";\n" > /etc/apt/apt.conf.d/90bunk-proxy && \
    printf 'Defaults env_keep += "HTTPS_PROXY HTTP_PROXY https_proxy http_proxy NO_PROXY no_proxy GIT_SSH_COMMAND"\n' > /etc/sudoers.d/bunk-proxy && \
    mkdir -p /etc/systemd/system/docker.service.d && \
    printf "[Service]\nEnvironment=HTTPS_PROXY=$p HTTP_PROXY=$p NO_PROXY=localhost,127.0.0.1\n" > /etc/systemd/system/docker.service.d/proxy.conf && \
    update-alternatives --set iptables /usr/sbin/iptables-legacy && update-alternatives --set ip6tables /usr/sbin/ip6tables-legacy
