# A box's root filesystem. build.sh builds it from scratch on the build
# machine and exports it to rootfs.ext4; see there for what goes in the
# context. Nothing in it is per box: a box's hostname, host key, and
# authorized_keys come from its identity drive at boot.
FROM ubuntu:24.04
ARG USER UID TARGETARCH

RUN userdel -r ubuntu && \
    apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      systemd systemd-sysv openssh-server iptables \
      git gh rsync socat curl ca-certificates sudo iproute2 dnsutils netcat-openbsd \
      nodejs npm python3-venv build-essential jq strace less \
    && rm -rf /var/lib/apt/lists/*

# A Mac boots the box with Ubuntu's own arm64 kernel, which build.sh takes
# from /boot; vsock is a module there, loaded without udev. Firecracker boots
# its own kernel, with vsock built in.
RUN if [ "$TARGETARCH" = arm64 ]; then \
      apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends linux-image-virtual && \
      rm -rf /var/lib/apt/lists/* && echo vmw_vsock_virtio_transport > /etc/modules-load.d/vsock.conf; \
    fi

# The user matches the build machine's, so ferry maps homes one to one.
# ~/.local/bin goes on PATH in /etc/environment, which every ssh session reads,
# not just login shells.
RUN useradd -m -u "$UID" -s /bin/bash -G sudo "$USER" && \
    echo "$USER ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/box-user && \
    install -d -o "$USER" -g "$USER" -m 700 /home/$USER/.ssh && \
    install -d -o "$USER" -g "$USER" /home/$USER/.local /home/$USER/.local/bin /home/$USER/.config /home/$USER/.config/ferry /home/$USER/.claude && \
    mkdir -p /etc/punchclock && echo "$USER" > /etc/punchclock/user && \
    sed -i "s|^PATH=\"|PATH=\"/home/$USER/.local/bin:|" /etc/environment

# Agents and tools. Rex's tarball install puts one binary in /usr/local/bin.
# build.sh changes AGENTS each day, so the first build of a day reinstalls
# these at their latest versions instead of reusing the cached layer.
ARG AGENTS
RUN echo "agents as of $AGENTS" && curl -fsSL https://pkgs.superlogical.com/rex/install.sh | sh -s -- --tarball && \
    npm i -g @openai/codex
USER $USER
RUN curl -fsSL https://claude.ai/install.sh | bash
USER root

# The box is the boundary: Claude runs without permission prompts. Onboarding
# is marked done so the TUI skips its direct check of api.anthropic.com, and
# the auto-mode nudge is marked seen so it doesn't wait on an answer.
COPY --chown=$UID:$UID claude-settings.json /home/$USER/.claude/settings.json
RUN v=$(su - "$USER" -c 'claude --version' | cut -d' ' -f1) && \
    su "$USER" -c "printf '{\"hasCompletedOnboarding\":true,\"lastOnboardingVersion\":\"%s\",\"hasSeenAutoDefaultNudge\":true}\n' $v > /home/$USER/.claude.json"

# Commits are made as the build machine's git user.
COPY user.gitconfig /etc/punchclock/gitconfig
RUN git config --system --add include.path /etc/punchclock/gitconfig

# hallpass's client side, from the build machine: boxes share its broker.
COPY hallpass /opt/hallpass/bin/hallpass
COPY hallpass-etc/ /etc/hallpass/
RUN ln -s hallpass /opt/hallpass/bin/hallpass-sign && \
    git config --system --add include.path /etc/hallpass/gitconfig

# ferry, from the build machine, so it speaks the laptop's protocol; the
# sandbox marker makes it answer agents' folder-trust prompts.
COPY --chown=$UID:$UID ferry /home/$USER/.local/bin/ferry
RUN touch /home/$USER/.config/ferry/sandbox && chown $UID:$UID /home/$USER/.config/ferry/sandbox

# punchclock's guest side: identity at boot, then every channel over vsock.
# There is no network device; the host is vsock CID 2.
COPY punchclock punchclock-identity /usr/local/bin/
COPY units/ /etc/systemd/system/
RUN rm -f /etc/ssh/ssh_host_* && \
    printf 'HostKey /etc/ssh/ssh_host_ed25519_key\nPasswordAuthentication no\n' > /etc/ssh/sshd_config.d/punchclock.conf && \
    systemctl enable ssh.service punchclock-identity.service punchclock-ready.service punchclock-clock.service \
      punchclock-ssh.service punchclock-proxy.service \
      punchclock-model.service punchclock-hallpass@hallpass.service punchclock-hallpass@gh.service \
      punchclock-hallpass@ssh.service punchclock-hallpass@git.service && \
    systemctl mask systemd-networkd-wait-online.service systemd-resolved.service serial-getty@ttyS0.service serial-getty@hvc0.service && \
    printf '/dev/vda / ext4 rw,relatime 0 1\n' > /etc/fstab && passwd -d root >/dev/null

# Everything reaches the internet through the proxy, including sudo, apt, and
# Docker. npm sets its own GIT_SSH_COMMAND, so it's pinned to hallpass here.
# Docker needs iptables' legacy backend: Firecracker's CI kernel has no nf_tables.
RUN p=http://127.0.0.1:3128 && \
    printf "HTTPS_PROXY=$p\nHTTP_PROXY=$p\nhttps_proxy=$p\nhttp_proxy=$p\nNO_PROXY=localhost,127.0.0.1\nno_proxy=localhost,127.0.0.1\nGIT_SSH_COMMAND=/opt/hallpass/bin/hallpass ssh\n" >> /etc/environment && \
    printf "Acquire::http::Proxy \"$p\";\nAcquire::https::Proxy \"$p\";\n" > /etc/apt/apt.conf.d/90punchclock-proxy && \
    printf 'Defaults env_keep += "HTTPS_PROXY HTTP_PROXY https_proxy http_proxy NO_PROXY no_proxy GIT_SSH_COMMAND"\n' > /etc/sudoers.d/punchclock-proxy && \
    mkdir -p /etc/systemd/system/docker.service.d && \
    printf "[Service]\nEnvironment=HTTPS_PROXY=$p HTTP_PROXY=$p NO_PROXY=localhost,127.0.0.1\n" > /etc/systemd/system/docker.service.d/proxy.conf && \
    update-alternatives --set iptables /usr/sbin/iptables-legacy && update-alternatives --set ip6tables /usr/sbin/ip6tables-legacy
